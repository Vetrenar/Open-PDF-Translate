{
    "name": "openrouter-pdf-translator",
    "version": "1.0.0",
    "description": "Translate PDF documents in Obsidian using OpenRouter and other LLM providers.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs development",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
    },
    "keywords": [
        "obsidian",
        "pdf",
        "translation",
        "openrouter",
        "ocr",
        "llm"
    ],
    "author": "OpenRouter PDF Translator Contributors",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@types/dompurify": "^3.0.5",
        "builtin-modules": "^4.0.0",
        "esbuild": "^0.20.0",
        "obsidian": "^1.7.2",
        "tslib": "^2.6.0",
        "typescript": "^5.3.0"
    },
    "dependencies": {
        "dompurify": "^3.0.6",
        "pdfjs-dist": "^3.11.174"
    }
}
