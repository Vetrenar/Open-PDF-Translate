{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2021",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleDetection": "force",
    "importHelpers": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": [
      "ES2021",
      "DOM"
    ]
  },
  "include": [
    "*.ts"
  ]
}
